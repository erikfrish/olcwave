# Set RW_ENABLED=False for standalone mode (no Remnawave dependency)
# Set RW_ENABLED=True for integration with Remnawave panel
RW_ENABLED=False

# Required only when RW_ENABLED=True
# RW_API_URL=https://CHANGE_WITH_RAMNAWAVE.url
# RW_API_TOKEN=
# RW_CADDY_TOKEN=

# Optional: PEM CA bundle for the Remnawave API client (empty = system store)
# RW_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Bounded revocation latency: seconds a Remnawave outage may keep
# previously-verified access before containers are removed (fail-closed).
REMNAWAVE_UNAVAILABLE_GRACE_SECONDS=120
# Background reconciliation sweep interval in seconds.
REVOCATION_CHECK_INTERVAL=30

DB_HOST=postgres
DB_PORT=5432
POSTGRES_USER=olcwave
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=main

ADMIN_USERNAME=admin
ADMIN_PASSWORD=strong_password_also_here

JWT_SECRET_KEY=change_me
JWT_EXPIRE_MINUTES=1440

# Optional
# changes user check from "User exists in rw?"
# to "User with this external squad exists?"
RW_SQUAD_NAME=
