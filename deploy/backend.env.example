# OLCWave API container environment (deploy/backend.env).
# NEVER COMMIT THE REAL FILE - it is gitignored (deploy/backend.env).
# This example shows every variable the dedicated-VM compose expects.

# ---- Remnawave panel upstream -------------------------------------------
# Ghostlane/Remnawave panel API. Parent provisions a least-scope token and a
# test-only internal squad for this VM.
RW_ENABLED=True
RW_API_URL=https://remnawave.example.org
RW_API_TOKEN=<least-scope token from parent - fill privately>
# Caddy auth token, only if the panel requires it (usually empty).
RW_CADDY_TOKEN=
# In-container path of the home CA. The compose mounts
# ./remnawave-ca.pem (the VM's organization-root-ca.pem copy) here.
RW_CA_BUNDLE=/certs/ca.pem

# ---- Revocation / reconciliation -----------------------------------------
REMNAWAVE_UNAVAILABLE_GRACE_SECONDS=120
REVOCATION_CHECK_INTERVAL=30

# ---- Postgres (matches compose service `postgres`) ------------------------
DB_HOST=postgres
DB_PORT=5432
POSTGRES_USER=olcwave
POSTGRES_PASSWORD=<private - generate with: openssl rand -hex 24>
POSTGRES_DB=main

# ---- OLCWave admin panel --------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<private - generate with: openssl rand -hex 16>
JWT_SECRET_KEY=<private - generate with: openssl rand -hex 32>
JWT_EXPIRE_MINUTES=1440

# ---- Squad gating ----------------------------------------------------------
# Name or UUID of the test-only internal squad; users outside it are denied.
RW_SQUAD_NAME=<test-only internal squad from parent>
